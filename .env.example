NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase project credentials. Row Level Security keeps anonymous users
# read-only and limits writes to authenticated users in admin_profiles.
# The public site uses labeled sample data when these values are omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public professional contact shown on the About page. Leave blank to show a
# privacy-safe unavailable state instead of a fictional or personal address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public founder identity and optional GitHub profile.
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_ROLE=
NEXT_PUBLIC_GITHUB_URL=

# Public verification token supplied by Google Search Console. Enter the token
# only, not the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set this to the final canonical origin in Vercel production, with no path.
# Vercel host variables are used as a fallback when it is omitted.
# NEXT_PUBLIC_SITE_URL=https://cre-research.example.com
